<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.1" xmlns="https://jakarta.ee/xml/ns/persistence">
  
  <persistence-unit name="ProyectoPU" transaction-type="JTA">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <jta-data-source>jdbc/AdmProyectos</jta-data-source>
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
    
    
    <class>cr.ac.una.admproyectosws.model.Administrador</class>
    <class>cr.ac.una.admproyectosws.model.Proyecto</class>
    <class>cr.ac.una.admproyectosws.model.Actividad</class>
    <class>cr.ac.una.admproyectosws.model.SeguimientoProyecto</class>
    
    <properties>
     
      <property name="jakarta.persistence.provider" value="org.eclipse.persistence.jpa.PersistenceProvider"/>
      
      
      <property name="eclipselink.logging.level" value="INFO"/>
      <property name="eclipselink.logging.level.sql" value="FINE"/>
      <property name="eclipselink.logging.parameters" value="true"/>
      
      
      <property name="eclipselink.target-database" value="Oracle"/>
      <property name="eclipselink.connection-pool.default.initial" value="5"/>
      <property name="eclipselink.connection-pool.default.min" value="5"/>
      <property name="eclipselink.connection-pool.default.max" value="20"/>
      
     
      <property name="eclipselink.weaving" value="false"/>
      
      
      <property name="eclipselink.ddl-generation" value="none"/>
      <property name="eclipselink.ddl-generation.output-mode" value="database"/>
      
      
      <property name="eclipselink.cache.shared.default" value="true"/>
      <property name="eclipselink.cache.size.default" value="1000"/>
      
     
      <property name="eclipselink.query-results-cache" value="true"/>
      <property name="eclipselink.query-results-cache.size" value="500"/>
      
      
      <property name="eclipselink.jpa.uppercase-column-names" value="false"/>
      <property name="eclipselink.validate-existence" value="true"/>
      
     
      <property name="eclipselink.temporal.mutable" value="true"/>
      
      
      <property name="eclipselink.connection-pool.read.initial" value="2"/>
      <property name="eclipselink.connection-pool.read.min" value="2"/>
      <property name="eclipselink.connection-pool.read.max" value="5"/>
      
      
      <property name="eclipselink.jdbc.batch-writing" value="JDBC"/>
      <property name="eclipselink.jdbc.batch-writing.size" value="100"/>
    </properties>
  </persistence-unit>
  
</persistence>